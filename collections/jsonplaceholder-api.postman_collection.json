                "exec": [
                  "var maxResponseTimeMs = Number(pm.variables.get('maxResponseTimeMs')) || 2000;",
                  "var postId = Number(pm.variables.get('postId')) || 1;",
                  "var userId = Number(pm.variables.get('userId')) || 1;",
                  "",
                  "pm.test('Status code is 200 or 204', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
                  "});",
                  "",
                  "pm.test('Response time is under ' + maxResponseTimeMs + 'ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(maxResponseTimeMs);",
                  "});",
