              }
            }
          ],
          "name": "Update post (PUT)",
          "request": {
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n  \"id\": {{postId}},\n  \"title\": \"{{updatedPostTitle}}\",\n  \"body\": \"{{updatedPostBody}}\",\n  \"userId\": {{userId}}\n}"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "PUT",
            "url": {
              "host": [
                "{{baseUrl}}"
