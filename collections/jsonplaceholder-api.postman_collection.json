{
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// Collection-level pre-request script.",
          "// Adds a timestamp header to every request so runs can be traced.",
          "var timestamp = new Date().toISOString();",
          "pm.request.headers.upsert({ key: 'X-Request-Timestamp', value: timestamp });"
        ],
        "type": "text/javascript"
      }
    }
  ],
  "info": {
    "_postman_id": "jsonplaceholder-api-collection",
    "description": "API tests for the JSONPlaceholder demo API - a free demo API. Covers posts, users and comments, plus negative cases. Run with Postman or Newman. All request URLs use the {{baseUrl}} variable; ids, payload text and the response-time limit come from collection / environment / data-file variables (see ARCHITECTURE.md). No hard-coded host, id or timeout in any request or test script.",
    "name": "JSONPlaceholder API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "item": [
        {
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var maxResponseTimeMs = Number(pm.variables.get('maxResponseTimeMs')) || 2000;",
                  "var postId = Number(pm.variables.get('postId')) || 1;",
                  "var userId = Number(pm.variables.get('userId')) || 1;",
                  "",
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response time is under ' + maxResponseTimeMs + 'ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(maxResponseTimeMs);",
                  "});",
                  "",
                  "pm.test('Response is a non-empty array of posts', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "    pm.expect(jsonData.length).to.be.above(0);",
                  "});",
                  "",
                  "pm.test('Each post has id, userId, title and body', function () {",
                  "    var jsonData = pm.response.json();",
                  "    jsonData.forEach(function (post) {",
                  "        pm.expect(post).to.have.property('id');",
                  "        pm.expect(post).to.have.property('userId');",
                  "        pm.expect(post).to.have.property('title');",
                  "        pm.expect(post).to.have.property('body');",
                  "        pm.expect(post.title).to.be.a('string').and.not.empty;",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "name": "Get all posts",
          "request": {
            "header": [],
            "method": "GET",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ],
              "raw": "{{baseUrl}}/posts"
            }
          }
        },
        {
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var maxResponseTimeMs = Number(pm.variables.get('maxResponseTimeMs')) || 2000;",
                  "var postId = Number(pm.variables.get('postId')) || 1;",
                  "var userId = Number(pm.variables.get('userId')) || 1;",
                  "",
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response time is under ' + maxResponseTimeMs + 'ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(maxResponseTimeMs);",
                  "});",
                  "",
                  "pm.test('Post has id 1 and expected fields', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.id).to.eql(postId);",
                  "    pm.expect(jsonData).to.have.property('userId');",
                  "    pm.expect(jsonData).to.have.property('title');",
                  "    pm.expect(jsonData).to.have.property('body');",
                  "    pm.expect(jsonData.title).to.be.a('string').and.not.empty;",
                  "    pm.expect(jsonData.body).to.be.a('string').and.not.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "name": "Get single post",
          "request": {
            "header": [],
            "method": "GET",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "{{postId}}"
              ],
              "raw": "{{baseUrl}}/posts/{{postId}}"
            }
          }
        },
        {
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var maxResponseTimeMs = Number(pm.variables.get('maxResponseTimeMs')) || 2000;",
                  "var postId = Number(pm.variables.get('postId')) || 1;",
                  "var userId = Number(pm.variables.get('userId')) || 1;",
                  "",
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response time is under ' + maxResponseTimeMs + 'ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(maxResponseTimeMs);",
                  "});",
                  "",
                  "pm.test('Created post echoes the sent fields and has an id', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData.title).to.eql(pm.variables.get('newPostTitle'));",
                  "    pm.expect(jsonData.body).to.eql(pm.variables.get('newPostBody'));",
                  "    pm.expect(jsonData.userId).to.eql(userId);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "name": "Create post",
          "request": {
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n  \"title\": \"{{newPostTitle}}\",\n  \"body\": \"{{newPostBody}}\",\n  \"userId\": {{userId}}\n}"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ],
              "raw": "{{baseUrl}}/posts"
            }
          }
        },
