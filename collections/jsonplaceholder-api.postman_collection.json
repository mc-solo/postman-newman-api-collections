                  "pm.test('Response body is empty or an empty object', function () {",
                  "    var body = pm.response.text();",
                  "    pm.expect(body === '' || body === '{}').to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "name": "Delete post",
