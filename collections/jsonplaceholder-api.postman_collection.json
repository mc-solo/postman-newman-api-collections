                  "pm.test('Patched title is returned', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.id).to.eql(postId);",
                  "    pm.expect(jsonData.title).to.eql(pm.variables.get('patchedPostTitle'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
