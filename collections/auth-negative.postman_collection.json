{"event":[{"listen":"prerequest","script":{"exec":["// Collection-level pre-request script.","// Adds a timestamp header to every request so runs can be traced.","var timestamp = new Date().toISOString();","pm.request.headers.upsert({ key: 'X-Request-Timestamp', value: timestamp });"],"type":"text/javascript"}}],"info":{"_postman_id":"auth-negative-collection","description":"Auth and negative-case tests for the public demo APIs: httpbin basic auth and bearer auth (valid and missing/wrong credentials), plus negative cases on JSONPlaceholder (missing fields, non-existent post, invalid endpoint). All URLs use {{baseUrl}} / {{httpbinBaseUrl}} variables; usernames, tokens, ids and the response-time limit come from collection / environment / data-file variables. No hard-coded host, credential or timeout in any request or test script. Note: JSONPlaceholder is a fake API with no validation, so the missing-fields request documents that it accepts the post (201) instead of rejecting it.","name":"Auth and Negative Cases","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},"item":[{"item":[{"event":[{"listen":"test","script":{"exec":["var maxResponseTimeMs = Number(pm.variables.get('maxResponseTimeMs')) || 2000;","","pm.test('Status code is 200', function () {","    pm.response.to.have.status(200);","});","","pm.test('Response time is under ' + maxResponseTimeMs + 'ms', function () {","    pm.expect(pm.response.responseTime).to.be.below(maxResponseTimeMs);","});","","pm.test('Response says authenticated is true', function () {","    var jsonData = pm.response.json();","    pm.expect(jsonData.authenticated).to.be.true;","    pm.expect(jsonData.user).to.eql(pm.variables.get('authUsername'));","});"],"type":"text/javascript"}}],"name":"Basic auth valid credentials","request":{"auth":{"basic":{"password":"{{authPassword}}","username":"{{authUsername}}"},"type":"basic"},"header":[],"method":"GET","url":{"host":["{{httpbinBaseUrl}}"],"path":["basic-auth","{{authUsername}}","{{authPassword}}"],"raw":"{{httpbinBaseUrl}}/basic-auth/{{authUsername}}/{{authPassword}}"}}},{"event":[{"listen":"test","script":{"exec":["var maxResponseTimeMs = Number(pm.variables.get('maxResponseTimeMs')) || 2000;","","pm.test('Status code is 401', function () {","    pm.response.to.have.status(401);","});","","pm.test('Response time is under ' + maxResponseTimeMs + 'ms', function () {","    pm.expect(pm.response.responseTime).to.be.below(maxResponseTimeMs);","});","","pm.test('Response does not say authenticated is true', function () {","    var body = pm.response.text();","    pm.expect(body).to.not.include('\"authenticated\": true');","});"],"type":"text/javascript"}}],"name":"Basic auth wrong password","request":{"auth":{"basic":{"password":"{{wrongPassword}}","username":"{{authUsername}}"},"type":"basic"},"header":[],"method":"GET","url":{"host":["{{httpbinBaseUrl}}"],"path":["basic-auth","{{authUsername}}","{{authPassword}}"],"raw":"{{httpbinBaseUrl}}/basic-auth/{{authUsername}}/{{authPassword}}"}}},{"event":[{"listen":"test","script":{"exec":["var maxResponseTimeMs = Number(pm.variables.get('maxResponseTimeMs')) || 2000;","","pm.test('Status code is 200', function () {","    pm.response.to.have.status(200);","});","","pm.test('Response time is under ' + maxResponseTimeMs + 'ms', function () {","    pm.expect(pm.response.responseTime).to.be.below(maxResponseTimeMs);","});","","pm.test('Response says authenticated is true and echoes the token', function () {","    var jsonData = pm.response.json();","    pm.expect(jsonData.authenticated).to.be.true;","    pm.expect(jsonData.token).to.eql(pm.variables.get('bearerToken'));","});"],"type":"text/javascript"}}],"name":"Bearer token valid","request":{"auth":{"bearer":[{"key":"token","type":"string","value":"{{bearerToken}}"}],"type":"bearer"},"header":[],"method":"GET","url":{"host":["{{httpbinBaseUrl}}"],"path":["bearer"],"raw":"{{httpbinBaseUrl}}/bearer"}}},{"event":[{"listen":"test","script":{"exec":["var maxResponseTimeMs = Number(pm.variables.get('maxResponseTimeMs')) || 2000;","","pm.test('Status code is 401', function () {","    pm.response.to.have.status(401);","});","","pm.test('Response time is under ' + maxResponseTimeMs + 'ms', function () {","    pm.expect(pm.response.responseTime).to.be.below(maxResponseTimeMs);","});","","pm.test('Response does not say authenticated is true', function () {","    var body = pm.response.text();","    pm.expect(body).to.not.include('\"authenticated\": true');","});"],"type":"text/javascript"}}],"name":"Bearer token missing","request":{"header":[],"method":"GET","url":{"host":["{{httpbinBaseUrl}}"],"path":["bearer"],"raw":"{{httpbinBaseUrl}}/bearer"}}}],"name":"Auth"},{"item":[{"event":[{"listen":"test","script":{"exec":["var maxResponseTimeMs = Number(pm.variables.get('maxResponseTimeMs')) || 2000;","var userId = Number(pm.variables.get('userId')) || 1;","","pm.test('Status code is 201', function () {","    pm.response.to.have.status(201);","});","","pm.test('Response time is under ' + maxResponseTimeMs + 'ms', function () {","    pm.expect(pm.response.responseTime).to.be.below(maxResponseTimeMs);","});","","pm.test('Fake API accepts the post without title/body (no validation) and returns an id', function () {","    var jsonData = pm.response.json();","    pm.expect(jsonData).to.have.property('id');","    pm.expect(jsonData.userId).to.eql(userId);","    pm.expect(jsonData).to.not.have.property('title');","});"],"type":"text/javascript"}}],"name":"Create post missing title and body","request":{"body":{"mode":"raw","options":{"raw":{"language":"json"}},"raw":"{\n  \"userId\": {{userId}}\n}"},"header":[{"key":"Content-Type","value":"application/json"}],"method":"POST","url":{"host":["{{baseUrl}}"],"path":["posts"],"raw":"{{baseUrl}}/posts"}}},{"event":[{"listen":"test","script":{"exec":["var maxResponseTimeMs = Number(pm.variables.get('maxResponseTimeMs')) || 2000;","","pm.test('Status code is 404', function () {","    pm.response.to.have.status(404);","});","","pm.test('Response time is under ' + maxResponseTimeMs + 'ms', function () {","    pm.expect(pm.response.responseTime).to.be.below(maxResponseTimeMs);","});","","pm.test('Response body is empty or an empty object', function () {","    var body = pm.response.text();","    pm.expect(body === '' || body === '{}').to.be.true;","});"],"type":"text/javascript"}}],"name":"Get non-existent post","request":{"header":[],"method":"GET","url":{"host":["{{baseUrl}}"],"path":["posts","{{nonExistentPostId}}"],"raw":"{{baseUrl}}/posts/{{nonExistentPostId}}"}}},{"event":[{"listen":"test","script":{"exec":["var maxResponseTimeMs = Number(pm.variables.get('maxResponseTimeMs')) || 2000;","","pm.test('Status code is 404', function () {","    pm.response.to.have.status(404);","});","","pm.test('Response time is under ' + maxResponseTimeMs + 'ms', function () {","    pm.expect(pm.response.responseTime).to.be.below(maxResponseTimeMs);","});","","pm.test('Response body is empty or an empty object', function () {","    var body = pm.response.text();","    pm.expect(body === '' || body === '{}').to.be.true;","});"],"type":"text/javascript"}}],"name":"Get invalid endpoint","request":{"header":[],"method":"GET","url":{"host":["{{baseUrl}}"],"path":["invalid-endpoint"],"raw":"{{baseUrl}}/invalid-endpoint"}}}],"name":"Negative Cases"}],"variable":[{"key":"baseUrl","value":"https://jsonplaceholder.typicode.com"},{"key":"httpbinBaseUrl","value":"https://httpbin.org"},{"key":"authUsername","value":"user"},{"key":"authPassword","value":"passwd"},{"key":"wrongPassword","value":"wrong-password"},{"key":"bearerToken","value":"demo-token-123"},{"key":"postId","value":"1"},{"key":"userId","value":"1"},{"key":"nonExistentPostId","value":"999999"},{"key":"maxResponseTimeMs","value":"2000"}]}