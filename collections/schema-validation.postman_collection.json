              "script": {
                "exec": [
                  "var maxResponseTimeMs = Number(pm.variables.get('maxResponseTimeMs')) || 2000;",
                  "var postId = Number(pm.variables.get('postId')) || 1;",
                  "var userId = Number(pm.variables.get('userId')) || 1;",
                  "var postSchema = JSON.parse(pm.variables.get('postSchema'));",
