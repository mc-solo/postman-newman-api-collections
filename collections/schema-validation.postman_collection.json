{
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// Collection-level pre-request script.",
          "// Adds a timestamp header to every request so runs can be traced.",
          "var timestamp = new Date().toISOString();",
          "pm.request.headers.upsert({ key: 'X-Request-Timestamp', value: timestamp });"
        ],
        "type": "text/javascript"
      }
    }
  ],
  "info": {
    "_postman_id": "schema-validation-collection",
    "description": "Response schema validation for the JSONPlaceholder demo API: posts and users endpoints. Each request has two schema checks: a tv4 JSON-schema validation against the postSchema / userSchema collection variables, and an explicit required-fields-and-types check. The schemas live in the collection variables so they travel with the collection; no schema, host, id or timeout is hard-coded in a request or test script. Default iteration data is test-data/posts.csv (3 rows), so the collection runs once per CSV row. Run with Postman or Newman. See docs/TESTING.md.",
    "name": "Schema Validation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "item": [
        {
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var maxResponseTimeMs = Number(pm.variables.get('maxResponseTimeMs')) || 2000;",
                  "var postId = Number(pm.variables.get('postId')) || 1;",
                  "var userId = Number(pm.variables.get('userId')) || 1;",
                  "var postSchema = JSON.parse(pm.variables.get('postSchema'));",
                  "var userSchema = JSON.parse(pm.variables.get('userSchema'));",
                  "",
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response time is under ' + maxResponseTimeMs + 'ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(maxResponseTimeMs);",
                  "});",
                  "",
                  "pm.test('Single post matches the post schema (tv4)', function () {",
                  "    var jsonData = pm.response.json();",
                  "    var result = tv4.validateResult(jsonData, postSchema);",
                  "    pm.expect(result.valid, JSON.stringify(result.error)).to.be.true;",
                  "});",
                  "",
                  "pm.test('Single post has all required fields with the right types', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.id).to.eql(postId);",
                  "    pm.expect(jsonData.userId).to.be.a('number');",
                  "    pm.expect(jsonData.title).to.be.a('string').and.not.empty;",
                  "    pm.expect(jsonData.body).to.be.a('string').and.not.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "name": "Get single post (schema)",
          "request": {
            "header": [],
            "method": "GET",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "{{postId}}"
              ],
              "raw": "{{baseUrl}}/posts/{{postId}}"
            }
          }
        },
        {
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var maxResponseTimeMs = Number(pm.variables.get('maxResponseTimeMs')) || 2000;",
                  "var postId = Number(pm.variables.get('postId')) || 1;",
                  "var userId = Number(pm.variables.get('userId')) || 1;",
                  "var postSchema = JSON.parse(pm.variables.get('postSchema'));",
                  "var userSchema = JSON.parse(pm.variables.get('userSchema'));",
                  "",
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response time is under ' + maxResponseTimeMs + 'ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(maxResponseTimeMs);",
                  "});",
                  "",
                  "pm.test('All posts match the post schema (tv4)', function () {",
                  "    var jsonData = pm.response.json();",
                  "    var schema = { type: 'array', items: postSchema };",
                  "    var result = tv4.validateResult(jsonData, schema);",
                  "    pm.expect(result.valid, JSON.stringify(result.error)).to.be.true;",
                  "});",
                  "",
                  "pm.test('Every post has all required fields with the right types', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array').and.not.empty;",
                  "    jsonData.forEach(function (post) {",
                  "        pm.expect(post.id).to.be.a('number');",
                  "        pm.expect(post.userId).to.be.a('number');",
                  "        pm.expect(post.title).to.be.a('string').and.not.empty;",
                  "        pm.expect(post.body).to.be.a('string').and.not.empty;",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "name": "Get all posts (schema)",
          "request": {
            "header": [],
            "method": "GET",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ],
              "raw": "{{baseUrl}}/posts"
            }
          }
        },
        {
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var maxResponseTimeMs = Number(pm.variables.get('maxResponseTimeMs')) || 2000;",
                  "var postId = Number(pm.variables.get('postId')) || 1;",
                  "var userId = Number(pm.variables.get('userId')) || 1;",
                  "var postSchema = JSON.parse(pm.variables.get('postSchema'));",
                  "var userSchema = JSON.parse(pm.variables.get('userSchema'));",
                  "",
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response time is under ' + maxResponseTimeMs + 'ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(maxResponseTimeMs);",
                  "});",
                  "",
                  "pm.test('Created post matches the post schema (tv4)', function () {",
                  "    var jsonData = pm.response.json();",
                  "    var result = tv4.validateResult(jsonData, postSchema);",
                  "    pm.expect(result.valid, JSON.stringify(result.error)).to.be.true;",
                  "});",
                  "",
                  "pm.test('Created post has all required fields with the right types and echoes the sent title and body', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData.userId).to.eql(userId);",
                  "    pm.expect(jsonData.title).to.eql(pm.variables.get('newPostTitle'));",
                  "    pm.expect(jsonData.body).to.eql(pm.variables.get('newPostBody'));",
                  "    pm.expect(jsonData.title).to.be.a('string').and.not.empty;",
                  "    pm.expect(jsonData.body).to.be.a('string').and.not.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "name": "Create post (schema)",
          "request": {
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n  \"title\": \"{{newPostTitle}}\",\n  \"body\": \"{{newPostBody}}\",\n  \"userId\": {{userId}}\n}"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "url": {
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ],
              "raw": "{{baseUrl}}/posts"
            }
          }
        }
      ],
      "name": "Posts Schema"
    },
