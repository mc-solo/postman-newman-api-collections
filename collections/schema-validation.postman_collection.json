                  "    pm.expect(jsonData.email).to.be.a('string').and.to.include('@');",
                  "    pm.expect(jsonData.address).to.be.an('object');",
                  "    pm.expect(jsonData.address.street).to.be.a('string');",
                  "    pm.expect(jsonData.address.city).to.be.a('string');",
                  "    pm.expect(jsonData.address.zipcode).to.be.a('string');",
                  "    pm.expect(jsonData.phone).to.be.a('string');",
                  "    pm.expect(jsonData.website).to.be.a('string');",
                  "    pm.expect(jsonData.company).to.be.an('object');",
                  "    pm.expect(jsonData.company.name).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "name": "Get single user (schema)",
          "request": {
