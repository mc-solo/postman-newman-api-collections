# Local overrides for Newman runs. Copy to `.env` and edit the values.
# `.env` is git-ignored; this file is safe to commit (no secrets here:
# JSONPlaceholder is a public demo API and needs no auth).
# Note: a real shell environment variable always wins over the same key
# in `.env`. See config/newman.config.json for the full defaults.

# Environment to run against: dev or prod (both point at the same demo API).
NEWMAN_ENV=dev

# Overrides the baseUrl variable from the environment file.
BASE_URL=https://jsonplaceholder.typicode.com

# Iteration data file for data-driven runs (JSON or CSV). Empty = no data file.
NEWMAN_DATA_FILE=

# How many times to run the whole collection.
NEWMAN_ITERATIONS=1

# Delay between requests, in ms.
NEWMAN_DELAY_REQUEST_MS=0

# Timeouts, in ms.
NEWMAN_TIMEOUT_REQUEST_MS=10000
NEWMAN_TIMEOUT_SCRIPT_MS=5000

# Comma-separated Newman reporters. html/json write to reports/.
NEWMAN_REPORTERS=cli,html,json

# HTML report path.
NEWMAN_HTML_REPORT=reports/report.html
