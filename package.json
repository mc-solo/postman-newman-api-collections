{"description":"Postman collection and Newman runner for the JSONPlaceholder demo API.","devDependencies":{"newman":"^6.2.3"},"name":"postman-newman-api-collections","private":true,"scripts":{"test":"node scripts/run-newman.js","test:auth":"node scripts/run-newman.js --collection collections/auth-negative.postman_collection.json","test:schema":"node scripts/run-newman.js --collection collections/schema-validation.postman_collection.json","test:schema-csv":"node scripts/run-newman.js --collection collections/schema-validation.postman_collection.json --data test-data/posts.csv","test:csv":"node scripts/run-newman.js --data test-data/posts.csv","test:data":"node scripts/run-newman.js --data test-data/posts.json","test:html":"node scripts/run-newman.js --reporters cli,html","test:prod":"node scripts/run-newman.js --env prod"},"version":"1.0.0"}